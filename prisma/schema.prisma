generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum PayMethod {
  CASH
  UPI
  CARD
}

enum SaleStatus {
  COMPLETED
  VOID
}

enum LedgerType {
  SALE
  SALE_RETURN
  PURCHASE
  SUPPLIER_PAYMENT
  EXPENSE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  sales        Sale[]
  returns      Return[]
  purchases    Purchase[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  hsnCode     String?
  gstRate     Decimal   @default(5) @db.Decimal(5, 2)
  active      Boolean   @default(true)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  createdAt   DateTime  @default(now())
}

model Variant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String   @unique
  barcode      String?  @unique
  size         String?
  color        String?
  costPrice    Decimal  @db.Decimal(12, 2)
  salePrice    Decimal  @db.Decimal(12, 2)
  stock        Int      @default(0)
  reorderLevel Int      @default(5)
  active       Boolean  @default(true)
  saleItems    SaleItem[]
  purchaseItems PurchaseItem[]
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  active    Boolean    @default(true)
  purchases Purchase[]
  ledger    LedgerEntry[]
  createdAt DateTime   @default(now())
}

model Purchase {
  id          String         @id @default(cuid())
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  invoiceNo   String?
  date        DateTime       @default(now())
  total       Decimal        @db.Decimal(12, 2)
  paid        Decimal        @default(0) @db.Decimal(12, 2)
  note        String?
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  qty        Int
  unitCost   Decimal  @db.Decimal(12, 2)
}

model Sale {
  id            String      @id @default(cuid())
  billNo        String      @unique
  staffId       String
  staff         User        @relation(fields: [staffId], references: [id])
  customerName  String?
  customerPhone String?
  subtotal      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  status        SaleStatus  @default(COMPLETED)
  createdAt     DateTime    @default(now())
  items         SaleItem[]
  payments      Payment[]
  returns       Return[]
  ledger        LedgerEntry[]
}

model SaleItem {
  id            String       @id @default(cuid())
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId     String
  variant       Variant      @relation(fields: [variantId], references: [id])
  name          String
  qty           Int
  unitPrice     Decimal      @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  gstRate       Decimal      @db.Decimal(5, 2)
  taxAmount     Decimal      @db.Decimal(12, 2)
  lineTotal     Decimal      @db.Decimal(12, 2)
  returnedQty   Int          @default(0)
  returnItems   ReturnItem[]
}

model Payment {
  id        String    @id @default(cuid())
  saleId    String
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PayMethod
  amount    Decimal   @db.Decimal(12, 2)
  reference String?
}

model Return {
  id            String       @id @default(cuid())
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id])
  refundMethod  PayMethod
  refundTotal   Decimal      @db.Decimal(12, 2)
  reason        String?
  processedById String
  processedBy   User         @relation(fields: [processedById], references: [id])
  createdAt     DateTime     @default(now())
  items         ReturnItem[]
  ledger        LedgerEntry[]
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  qty        Int
  amount     Decimal  @db.Decimal(12, 2)
}

// amount is always positive; type decides whether money came in or went out
model LedgerEntry {
  id          String     @id @default(cuid())
  date        DateTime   @default(now())
  type        LedgerType
  amount      Decimal    @db.Decimal(12, 2)
  description String?
  saleId      String?
  sale        Sale?      @relation(fields: [saleId], references: [id])
  returnId    String?
  return      Return?    @relation(fields: [returnId], references: [id])
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])

  @@index([date])
  @@index([type])
}
