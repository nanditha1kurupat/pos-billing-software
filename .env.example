# Neon: pooled connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Neon: direct connection string (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Any long random string (at least 32 characters)
AUTH_SECRET="change-me-to-a-long-random-string-32chars+"
